# ============================================================================
# LingoQuest — Firebase Configuration (Required for Vercel & Local Dev)
# Copy these values from Firebase Console → Project Settings → Your Apps (Web)
# In Vercel: Project → Settings → Environment Variables (Production, Preview, Development)
# ============================================================================
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_DATABASE_ID="(default)"

# Optional Server-Side Gemini API Key (for AI Writing Lab Coach)
GEMINI_API_KEY=""

# Optional Cloud SQL PostgreSQL Configuration (for full-stack Node server mode)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
