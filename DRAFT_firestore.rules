rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // 0. Global Default-Deny Catch-All
    // ====================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ====================================================
    // Helper Primitives
    // ====================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin check: checks /admins/{uid}, user's role in /users/{uid}, or bootstrapped Division Admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ) ||
        (
          request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'admin.davaooriental@deped.gov.ph',
            'neilwin.guitguitin2001@gmail.com'
          ]
        )
      );
    }

    // Teacher check: verifies user has role == 'teacher' (and approved status if present) in /users/{uid}
    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
        (
          !('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        );
    }

    // ====================================================
    // 1. Users Collection (/users/{uid})
    // Schema: displayName, email, role, gradeLevel, school, section, createdAt, lastLoginAt
    // (Also supports LingoQuest extended fields: name, schoolName, status, classCode, lrn, points, etc.)
    // ====================================================
    function isValidUserPayload(data) {
      return data.role in ['student', 'teacher', 'admin'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('school' in data) || (data.school is string && data.school.size() <= 180)) &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 180)) &&
        (!('section' in data) || (data.section is string && data.section.size() <= 80)) &&
        (!('gradeLevel' in data) || data.gradeLevel in [7, 8, 9, 10]);
    }

    match /users/{uid} {
      // Users can read their own profile; teachers can read student profiles; admins have full access
      allow get: if isSignedIn() && isValidId(uid) && (
        isOwner(uid) ||
        isAdmin() ||
        (isTeacher() && existing().role == 'student')
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (isTeacher() && existing().role == 'student') ||
        existing().uid == request.auth.uid ||
        existing().id == request.auth.uid
      );

      // Users can create their own profile on signup.
      // Default role on signup is 'student'. Clients can NEVER self-assign active 'teacher' or 'admin'.
      // (Teacher signups are only permitted if status == 'pending' awaiting admin approval.)
      allow create: if isSignedIn() && isValidId(uid) && isValidUserPayload(incoming()) && (
        isAdmin() ||
        (
          isOwner(uid) &&
          (
            incoming().role == 'student' ||
            (incoming().role == 'teacher' && incoming().status == 'pending')
          )
        )
      );

      // Users can update their own profile, but CANNOT change their own `role` field
      allow update: if isSignedIn() && isValidId(uid) && isValidUserPayload(incoming()) && (
        isAdmin() ||
        (
          isOwner(uid) &&
          incoming().role == existing().role &&
          (!('status' in existing()) || incoming().status == existing().status)
        ) ||
        (
          isTeacher() &&
          existing().role == 'student' &&
          incoming().role == 'student' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'name', 'gradeLevel', 'school', 'schoolName',
            'section', 'lrn', 'learnerId', 'enrollmentStatus', 'status', 'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin() && isValidId(uid);
    }

    // ====================================================
    // 2. Progress Collection (/progress/{uid})
    // Schema: xp, level, coins, gems, streak, currentIsland, unlockedIslands[], completedQuests[], updatedAt
    // ====================================================
    function isValidProgressPayload(data) {
      return (!('xp' in data) || (data.xp is number && data.xp >= 0)) &&
        (!('level' in data) || (data.level is number && data.level >= 1)) &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('gems' in data) || (data.gems is number && data.gems >= 0)) &&
        (!('streak' in data) || (data.streak is number && data.streak >= 0)) &&
        (!('currentIsland' in data) || (data.currentIsland is string && data.currentIsland.size() <= 120)) &&
        (!('unlockedIslands' in data) || (data.unlockedIslands is list && data.unlockedIslands.size() <= 50)) &&
        (!('completedQuests' in data) || (data.completedQuests is list && data.completedQuests.size() <= 200));
    }

    match /progress/{uid} {
      // Owner can read their own progress; teachers can read students' progress; admins have full access
      allow get: if isSignedIn() && isValidId(uid) && (
        isOwner(uid) ||
        isTeacher() ||
        isAdmin() ||
        ('userId' in existing() && existing().userId == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        isTeacher() ||
        isAdmin() ||
        ('uid' in existing() && existing().uid == request.auth.uid) ||
        ('userId' in existing() && existing().userId == request.auth.uid)
      );

      // Owner can create/update only their own progress/{uid} doc; admins have full access
      allow create, update: if isSignedIn() && isValidId(uid) && isValidProgressPayload(incoming()) && (
        isOwner(uid) ||
        isAdmin() ||
        ('userId' in incoming() && incoming().userId == request.auth.uid)
      );

      allow delete: if isAdmin() && isValidId(uid);
    }

    // ====================================================
    // 3. Quiz Results Collection (/quizResults/{resultId})
    // Schema: uid, questId, score, total, timeSpent, createdAt
    // ====================================================
    function isValidQuizResultPayload(data) {
      return data.keys().hasAll(['uid', 'questId', 'score', 'total', 'timeSpent', 'createdAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.questId is string && data.questId.size() > 0 && data.questId.size() <= 100 &&
        data.score is number && data.score >= 0 &&
        data.total is number && data.total > 0 &&
        data.timeSpent is number && data.timeSpent >= 0;
    }

    match /quizResults/{resultId} {
      // Students can read their own quizResults; teachers can read all students' quizResults; admins have full access
      allow get: if isSignedIn() && isValidId(resultId) && (
        existing().uid == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().uid == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );

      // Students can record their own quiz results; admins have full access
      allow create: if isSignedIn() && isValidId(resultId) && isValidQuizResultPayload(incoming()) && (
        incoming().uid == request.auth.uid ||
        isAdmin()
      );

      allow update, delete: if isAdmin() && isValidId(resultId);
    }

    // ====================================================
    // 4. Leaderboard Collection (/leaderboard/{uid})
    // Schema: displayName, school, xp, level
    // Publicly readable, owner writable with xp >= 0 validation
    // ====================================================
    function isValidLeaderboardPayload(data) {
      return data.keys().hasAll(['displayName', 'school', 'xp', 'level']) &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
        data.school is string && data.school.size() <= 180 &&
        data.xp is number && data.xp >= 0 &&
        data.level is number && data.level >= 1;
    }

    match /leaderboard/{uid} {
      // Publicly readable by anyone (including guests)
      allow get, list: if true;

      // Writable only by the owner (or admin), with validation that xp is a non-negative number
      allow create, update: if isSignedIn() && isValidId(uid) &&
        (isOwner(uid) || isAdmin()) &&
        isValidLeaderboardPayload(incoming());

      allow delete: if isAdmin() && isValidId(uid);
    }

    // ====================================================
    // 5. Supporting Admin & Curriculum Collections
    // ====================================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    match /modules/{moduleId} {
      allow get: if isSignedIn() && isValidId(moduleId);
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(moduleId);
    }

    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
