  "ssml": "<speak version=\"1.0\" xmlns=\"http://www.w3.org/2001/10/synthesis\" xmlns:mstts=\"https://www.w3.org/2001/mstts\" xml:lang=\"en-PH\">\n  <voice name=\"en-PH-RosaNeural\">\n    <mstts:express-as style=\"friendly\">\n      <prosody rate=\"93%\" pitch=\"+1%\">\n        First, <break time=\"300ms\"/> ask yourself a quick question. <break time=\"550ms\"/> Are the two words <emphasis level=\"moderate\">opposites</emphasis>, <break time=\"300ms\"/> or are they <emphasis level=\"moderate\">twins</emphasis>? <break time=\"650ms\"/> <emphasis level=\"moderate\">Antonyms</emphasis> have opposite meanings, <break time=\"300ms\"/> like night is to day. <break time=\"550ms\"/> <emphasis level=\"moderate\">Synonyms</emphasis> mean the exact same thing, <break time=\"300ms\"/> like happy is to joyful!\n      </prosody>\n    </mstts:express-as>\n  </voice>\n</speak>",
