  "ssml": "<speak version=\"1.0\" xmlns=\"http://www.w3.org/2001/10/synthesis\" xmlns:mstts=\"https://www.w3.org/2001/mstts\" xml:lang=\"en-PH\">\n  <voice name=\"en-PH-RosaNeural\">\n    <mstts:express-as style=\"friendly\">\n      <prosody rate=\"93%\" pitch=\"+1%\">\n        Two more quick tips! <break time=\"550ms\"/> First, <break time=\"300ms\"/> match the <emphasis level=\"moderate\">grammar</emphasis>. <break time=\"550ms\"/> If Pair One uses two <emphasis level=\"moderate\">adjectives</emphasis>, <break time=\"300ms\"/> like courageous is to brave, <break time=\"300ms\"/> Pair Two must also use two <emphasis level=\"moderate\">adjectives</emphasis>, <break time=\"300ms\"/> like honest is to truthful. <break time=\"550ms\"/> Second, <break time=\"300ms\"/> don&apos;t get fooled by words that just sound related. <break time=\"550ms\"/> Fish is to sea tells us where a fish lives, <break time=\"300ms\"/> so lion is to <emphasis level=\"moderate\">forest</emphasis>, <break time=\"300ms\"/> not roar!\n      </prosody>\n    </mstts:express-as>\n  </voice>\n</speak>",
