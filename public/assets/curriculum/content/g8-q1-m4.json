671875,84.72998046875]},"406faf356438f9913fa8":{"type":"paragraph","page":10,"text":"paragraphs for coherence. They also indicate building up new idea or thought or compare ideas or draw conclusions.","bbox":[72.0250015258789,87.07502746582031,526.5521240234375,113.72998046875]},"de929ddc84da68c138a7":{"type":"paragraph","page":10,"text":"Transition signals are of different types and each type helps to make certain","bbox":[108.0199966430664,130.6649932861328,526.5860595703125,142.92999267578125]},"7e68b6b18e8fc2571ffd":{"type":"paragraph","page":10,"text":"connections.","bbox":[72.0250015258789,145.2649688720703,139.9080047607422,157.52996826171875]},"ef87983d11d9a0379cae":{"type":"heading","page":10,"text":"Common Types and Functions of Transition Words:","bbox":[72.0250015258789,174.2949981689453,352.5580139160156,186.55999755859375]},"afa3bc3bf8d74a433852":{"type":"paragraph","page":10,"text":"1. Comparison/Contrast points out alternatives or differences:","bbox":[90.0250015258789,203.49501037597656,406.5880126953125,215.760009765625]},"fad8cafe058cb6c3e30a":{"type":"table","rows":[["Comparison","Contrast"],["as also likewise similarly in the same way","but despite however even though on the contrary"]],"bbox":[175.58333333333334,232.183349609375,424.9966735839844,322.54665120442706],"text":"Comparison Contrast as also likewise similarly in the same way but despite however even though on the contrary","page":10},"c435d97c06e1346a5c2a":{"type":"paragraph","page":10,"text":"Example:","bbox":[90.0250015258789,323.31500244140625,138.9080047607422,335.5799865722656]},"c64bd4e8a4749edd4112":{"type":"paragraph","page":10,"text":"My mom loves pasta, but she dislikes spaghetti. Similarly, she did not","bbox":[144.0500030517578,343.71502685546875,489.14508056640625,355.9800109863281]},"51cbb9888dd892de7632":{"type":"paragraph","page":10,"text":"like lasagna. On the contrary, she loves macaroni. Likewise, she loves pancit guisado, pancit bihon, sotanghon, and palabok.","bbox":[108.0199966430664,358.31500244140625,489.1800231933594,385.17999267578125]},"e73acc450de8ee08d197":{"type":"paragraph","page":10,"text":"2. Chronology helps define time:","bbox":[90.0250015258789,401.94500732421875,263.9380187988281,414.2099914550781]},"69585d967e8c1d3a1478":{"type":"paragraph","page":10,"text":"after","bbox":[142.64999389648438,423.94500732421875,167.70799255371094,436.2099914550781]},"fb53505980ec70506a0d":{"type":"paragraph","page":10,"text":"before","bbox":[196.64999389648438,423.94500732421875,235.7379913330078,436.2099914550781]},"cd7b4a841c06e67a3c4f":{"type":"paragraph","page":10,"text":"during","bbox":[268.6700134277344,423.94500732421875,307.7580261230469,436.2099914550781]},"ebbab1715d7fbeca3236":{"type":"paragraph","page":10,"text":"first","bbox":[376.7300109863281,423.94500732421875,400.5780029296875,436.2099914550781]},"9836f09eaa8e056f69cf":{"type":"paragraph","page":10,"text":"later","bbox":[142.64999389648438,444.3450012207031,167.10800170898438,456.6099853515625]},"b8c8dcb34dd7c12234ec":{"type":"paragraph","page":10,"text":"next","bbox":[196.64999389648438,444.3450012207031,220.53799438476562,456.6099853515625]},"23dfa0fc3aa0ba125f69":{"type":"paragraph","page":10,"text":"simultaneously","bbox":[268.6700134277344,444.3450012207031,344.5580139160156,456.6099853515625]},"a4a4c50def21c95b35e5":{"type":"paragraph","page":10,"text":"soon","bbox":[376.7300109863281,444.3450012207031,415.78802490234375,456.6099853515625]},"d3480f1ff99336618ed6":{"type":"paragraph","page":10,"text":"Example:","bbox":[90.0250015258789,469.5450134277344,138.9080047607422,481.80999755859375]},"0f2cbb9666284348910d":{"type":"paragraph","page":10,"text":"Before you go to the stadium to watch your favorite basketball game, make","bbox":[144.0500030517578,484.14501953125,507.18304443359375,496.4100036621094]},"729534b60452a7beeefd":{"type":"paragraph","page":10,"text":"sure that you have your snacks and video camera that you will use during the game. Later, you will find it enjoyable when you can simultaneously eat while videotaping.","bbox":[108.0199966430664,498.7750244140625,507.19903564453125,540.0299682617188]},"290d8b0f1d5a3b745918":{"type":"paragraph","page":10,"text":"3. Cause/Effect - shows the consequences of an action:","bbox":[90.0250015258789,556.9650268554688,374.1880187988281,569.2300415039062]},"ce2929d637ea44fd4c34":{"type":"table","rows":[["Cause","Effect"],["accordingly because due to since","consequently as a result therefore so"]],"bbox":[136.79000244140624,578.2633463541666,458.1700012207031,652.0166829427084],"text":"Cause Effect accordingly because due to since consequently as a result therefore so","page":10},"61c413bea5c3ae48b620":{"type":"paragraph","page":10,"text":"Example:","bbox":[90.0250015258789,665.594970703125,138.9080047607422,677.8599853515625]},"431b8d0234e8f4057942":{"type":"paragraph","page":10,"text":"Since you have been a consistent honor student and a skillful one,","bbox":[144.0500030517578,680.1950073242188,489.2080078125,692.4600219726562]},"638b582868dd3e133cb3":{"type":"paragraph","page":10,"text":"therefore, there would be a possibility that you would graduate cum laude or be cited with technical skills award in college. As a result, you would have a better chance to find a job or be an entrepreneur, because some companies would prefer those applicants with impressive school records or those with technical skills.","bbox":[108.0199966430664,694.7949829101562,489.1999816894531,765.2849731445312]},"b8bfa2a460e56b3ba322":{"type":"paragraph","page":11,"text":"4. Illustration/Example add emphasis or introduce evidence:","bbox":[90.0250015258789,72.46498107910156,398.5880126953125,84.72998046875]},"c2ae6fcc0435629c624c":{"type":"table","rows":[["Illustration","Example"],["to demonstrate specifically truly","for example such as namely"]],"bbox":[104.15333048502605,91.95332845052083,491.2166748046875,151.09663899739584],"text":"Illustration Example to demonstrate specifically truly for example such as namely","page":11},"fd10bbd23dfb17a2359c":{"type":"paragraph","page":11,"text":"Example:","bbox":[90.0250015258789,157.2949981689453,142.10800170898438,169.55999755859375]},"6675f5b4d8f32e2a49df":{"type":"paragraph","page":11,"text":"Mateo loves vegetables. Truly, he is happy to eat those every day","bbox":[144.0500030517578,171.6950225830078,488.9790954589844,183.96002197265625]},"2688c21c5bd8d09e1521":{"type":"paragraph","page":11,"text":"- specifically,","bbox":[108.0199966430664,186.2949981689453,180.30799865722656,198.55999755859375]},"e6f7fb8585330a6d1064":{"type":"paragraph","page":11,"text":"‘pinakbet’,","bbox":[194.64999389648438,186.2949981689453,247.13800048828125,198.55999755859375]},"67dcf28249c745031a16":{"type":"paragraph","page":11,"text":"‘chopsuey’,","bbox":[261.4800109863281,186.2949981689453,319.56103515625,198.55999755859375]},"61e7a124fbc54c6c6506":{"type":"paragraph","page":11,"text":"and","bbox":[333.89404296875,186.2949981689453,355.5310363769531,198.55999755859375]},"cccca37bb7d2e77c801e":{"type":"paragraph","page":11,"text":"vegetable","bbox":[369.92999267578125,186.2949981689453,420.7499694824219,198.55999755859375]},"144ab6aba7bb6f08011e":{"type":"paragraph","page":11,"text":"salads. To","bbox":[434.8849792480469,186.2949981689453,489.2080383300781,198.55999755859375]},"05783a6d8562312f8ad5":{"type":"paragraph","page":11,"text":"demonstrate his love for vegetables, Mateo is planning a vegetable socials for all his friends.","bbox":[108.0199966430664,200.8949737548828,489.2010192871094,227.760009765625]},"877f7e0657e65e36bb38":{"type":"paragraph","page":11,"text":"5. Addition adds information or reinforces ideas:","bbox":[90.0250015258789,244.49501037597656,336.7580261230469,256.760009765625]},"7f5fa2dc7135a0652667":{"type":"paragraph","page":11,"text":"furthermore","bbox":[142.85000610351562,265.8949890136719,202.7379913330078,278.15997314453125]},"f2cba388c4ab7cfafbf7":{"type":"paragraph","page":11,"text":"also","bbox":[232.8800048828125,265.8949890136719,259.13800048828125,278.15997314453125]},"3cfb8a0775be612bd2a7":{"type":"paragraph","page":11,"text":"moreover","bbox":[304.8999938964844,265.8949890136719,361.97802734375,278.15997314453125]},"1ad4311ce607f285abcf":{"type":"paragraph","page":11,"text":"and","bbox":[412.9200134277344,265.8949890136719,434.3780212402344,278.15997314453125]},"08a0dc0d3d305933aa59":{"type":"paragraph","page":11,"text":"in addition","bbox":[142.85000610351562,286.5149841308594,199.10800170898438,298.77996826171875]},"aeb438f73413c7b52d57":{"type":"paragraph","page":11,"text":"as well","bbox":[232.8800048828125,286.5149841308594,272.53802490234375,298.77996826171875]},"12149bb39494f785ee97":{"type":"paragraph","page":11,"text":"equally important","bbox":[304.8999938964844,286.5149841308594,397.97802734375,298.77996826171875]},"f661d754473f7ccc5b7f":{"type":"paragraph","page":11,"text":"then","bbox":[412.9200134277344,286.5149841308594,436.81597900390625,299.219970703125]},"6b1eee5e54bacc958828":{"type":"paragraph","page":11,"text":"Example:","bbox":[93.625,317.3250427246094,142.50799560546875,329.59002685546875]},"1873a2d225dbda2a021f":{"type":"paragraph","page":11,"text":"Gabriel loves, respects, and obeys his parents. Moreover, he helps in the","bbox":[144.0500030517578,331.7250061035156,526.51611328125,343.989990234375]},"b697eab50f9198da3430":{"type":"paragraph","page":11,"text":"household chores if he is not studying. Furthermore, he is grateful that his parents are very supportive in every task he does.","bbox":[108.0199966430664,346.32501220703125,526.4342041015625,373.17999267578125]},"59bd5d641834d27d10b2":{"type":"paragraph","page":11,"text":"6. Clarification shows support:","bbox":[90.0250015258789,389.94500732421875,251.7379913330078,402.2099914550781]},"2b022b79651089fcf50c":{"type":"paragraph","page":11,"text":"that is","bbox":[142.4499969482422,415.5450134277344,181.50799560546875,427.80999755859375]},"f1e516b312ed9e23341e":{"type":"paragraph","page":11,"text":"in other words","bbox":[214.47000122070312,415.5450134277344,289.5580139160156,427.80999755859375]},"7c64b9221cf9b42d9c33":{"type":"paragraph","page":11,"text":"to put it another way","bbox":[322.5,415.5450134277344,427.77801513671875,427.80999755859375]},"a7fc55b06c5d555fe90f":{"type":"paragraph","page":11,"text":"I mean","bbox":[142.4499969482422,440.7450256347656,181.50799560546875,453.010009765625]},"57ae9936d3ecf0f1d7f1":{"type":"paragraph","page":11,"text":"in this case","bbox":[214.47000122070312,440.7450256347656,272.53802490234375,453.010009765625]},"adcd9ef07da1f288d1da":{"type":"paragraph","page":11,"text":"under certain circumstances","bbox":[322.5,440.7450256347656,465.635986328125,453.45001220703125]},"a955bf686ec0404852f3":{"type":"paragraph","page":11,"text":"Example:","bbox":[93.625,480.7450256347656,142.50799560546875,493.010009765625]},"f0337efca331939aef0f":{"type":"paragraph","page":11,"text":"I love going to school; that is, I like it very much. In other words, I","bbox":[144.0500030517578,495.3650207519531,471.2080078125,507.6300048828125]},"5f09dff2e0c326c94ad3":{"type":"paragraph","page":11,"text":"want to learn more. To put it another way, a school is one of the best places I need to go for me to learn better.","bbox":[108.0199966430664,509.7649841308594,487.8191223144531,536.6399536132812]},"50c09b1d7a3762530d57":{"type":"paragraph","page":11,"text":"7. Qualification presents conditions or intentions:","bbox":[90.0250015258789,553.5650024414062,341.5580139160156,565.8300170898438]},"8a9d3f8810c914611dff":{"type":"paragraph","page":11,"text":"almost","bbox":[142.25,579.7749633789062,181.30799865722656,592.0399780273438]},"40f312c01c3e12c69cdb":{"type":"paragraph","page":11,"text":"with this in mind","bbox":[250.27000427246094,579.7749633789062,343.3580017089844,592.0399780273438]},"bc5df618b522d2fd0f24":{"type":"paragraph","page":11,"text":"possibly","bbox":[394.3299865722656,579.7749633789062,437.1880187988281,592.0399780273438]},"665c1c790271d4c9c62f":{"type":"paragraph","page":11,"text":"probably","bbox":[142.25,600.1649780273438,199.30799865722656,612.4299926757812]},"cf1cfeb818c8ea526eb9":{"type":"paragraph","page":11,"text":"frequently","bbox":[250.27000427246094,600.1649780273438,307.3580017089844,612.4299926757812]},"e0cb8a76a96c8126df27":{"type":"paragraph","page":11,"text":"never","bbox":[394.3299865722656,600.1649780273438,424.406005859375,612.8699951171875]},"4486870da2306b5b3770":{"type":"paragraph","page":11,"text":"Example:","bbox":[108.0199966430664,635.7949829101562,156.9080047607422,648.0599975585938]},"50a6fe22db80ca397cd9":{"type":"paragraph","page":11,"text":"With what was possibly the greatest fight of all times, the Filipino in the front","bbox":[144.0500030517578,656.1950073242188,525.0430297851562,668.4600219726562]},"d59532bb0525e0a98d91":{"type":"paragraph","page":11,"text":"lines faced the pandemic with bravery. They almost gave up but recovered. With this in mind, Filipinos have proven time and again to be resilient.","bbox":[108.0199966430664,670.7949829101562,525.1640014648438,697.6599731445312]},"62aaa8e11e16b8a63598":{"type":"paragraph","page":12,"text":"8. Summary/Conclusion restates ideas:","bbox":[90.0250015258789,72.46498107910156,298.7580261230469,84.72998046875]}},"excerptBlocks":{"concepts:0":["cee2fb372e2d722dfbed","bcb8aedd1ef3f2083bda","6f3c0c9692dc2b12735f","22d4919a739d7279afea","3c855d4e1ebb9b00f8b7","5df52cd64daa5dd50819","0734398adb78cb673dd7"],"concepts:1":["6c24d38d2475d6f5d5fe","406faf356438f9913fa8","de929ddc84da68c138a7","7e68b6b18e8fc2571ffd","ef87983d11d9a0379cae","afa3bc3bf8d74a433852","fad8cafe058cb6c3e30a","c435d97c06e1346a5c2a","c64bd4e8a4749edd4112","51cbb9888dd892de7632","e73acc450de8ee08d197","69585d967e8c1d3a1478","fb53505980ec70506a0d","cd7b4a841c06e67a3c4f","ebbab1715d7fbeca3236","9836f09eaa8e056f69cf","b8c8dcb34dd7c12234ec","23dfa0fc3aa0ba125f69","a4a4c50def21c95b35e5","d3480f1ff99336618ed6","0f2cbb966628