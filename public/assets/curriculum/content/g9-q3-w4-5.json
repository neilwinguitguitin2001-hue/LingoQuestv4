ation","","","","The majority of the information used in the material came from credible sources.","","","","Most of the information used in the material came from sources that are not credible.","","","",""],["","","","","","used in the material","","","","","","","","","","","",""],["","","","","","came from credible","","","","","","","","","","","",""],["","","","","","sources.","","","","","","","","","","","",""]]},"afc6647cffe9720ae588":{"type":"paragraph","text":"In this module, you will learn to determine the relevance and the truthfulness of the ideas presented in a material viewed. Specifically, it will help you:","bbox":[72.0,123.56004333496094,526.6220092773438,164.54002380371094],"page":2},"e93dadcc14caf79b7f89":{"type":"paragraph","text":"1. judge the relevance and worth of the ideas presented in a viewing material;\n2. form decisions based on such ideas; and\n3. relate the viewing material's content to particular social issues, concerns, or","bbox":[90.0250015258789,164.9600067138672,526.5579223632812,219.7400360107422],"page":2},"6f6df62ca24ae2ce7c02":{"type":"figure","bbox":[128.89999389648438,251.5,466.3999938964844,589.0],"src":"/assets/curriculum/figures/9c724351983a6b3fb728c2f9.webp","text":"","width":300,"height":300,"page":2},"2e349a93e0d7b90b2e18":{"type":"paragraph","text":"In determining the relevance and the truthfulness of the ideas presented in the materials viewed, the following factors must be considered.","bbox":[72.0,155.56004333496094,526.4600219726562,182.7400360107422],"page":6},"b0274ce5380e80d13a36":{"type":"figure","bbox":[71.9000015258789,201.00003051757812,521.7000122070312,471.5000305175781],"src":"/assets/curriculum/figures/07d10274aa472d826a8cf59c.webp","text":"","width":1006,"height":348,"page":6,"transcript":"Relevance"},"69d2db811e517fbb331c":{"type":"figure","bbox":[128.89999389648438,251.5,466.3999938964844,589.0],"src":"/assets/curriculum/figures/9c724351983a6b3fb728c2f9.webp","text":"","width":300,"height":300,"pag