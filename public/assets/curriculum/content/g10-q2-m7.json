rriculum/figures/688baef3afb249992646dd01.webp":"data:image/webp;base64,"},"sourceSections":[{"id":"concepts","title":"Concepts & Rules","kind":"discussion","entries":[{"page":7,"blockIds":["fd68272d88faca13376e","2b22a4cad8b625f90fa5","ebbb32a7b860e7db54a6","a0c4c07761f6ca398eb8","7f661ce409d0c9e2358b","9ac5f923c29d83e7bc31","988c5cfd17264b0ce2c3","29bdcc0c2dd7de012602","69cdb0a92c4c28df4d93","26955b9af423529af947","033b40e48d6846f7bbb8","1e1e0380ebff33619712","5a42a68f638e57dd97ee","7403712040d1196b6ed4","af961ec8cbec206471f2","bb3787c6563a607f1d94"]},{"page":8,"blockIds":["a572c77ff47cf6ace357","840bd5f58094a8971ee0","cdbee9fd0c4e6e57e0e4"]},{"page":9,"blockIds":["e154b2a01a558eb71a18","7eed9316fac20676447a","b6b3c2c8765944e0f4e8","523523b855b97835137c","0ad9b45341deb5f7020a","78de0a9f0601f291497e","a1968e1c7ae9a7ce57db","cd3601eafc93ea71a165","8bd1982cd099f977d8dd","7eb11a621a553c0d3011","7fcd95cedcd0ad588cc0"]},{"page":10,"blockIds":["9b3eea445280fee4fe19","1d6a624b1c6d1fb28cc0","5001155b995fbabc9442","fdd33bc52ed4bd85d730","4acf87c889c5786616ac","5cfd2023013187f17171","5aae5a180d6af3560a04","c761e19263db0e50e334","ed50546877a687a8c1a7","fc9d6fe7de380cd6f3a0","0d2a4b3fcfae1a48352b","956b472cc37fb9097d41","230cc470b6024a34cfa4","2709dfe5c98df86c7abe","b20054277f75918521cb"]},{"page":11,"blockIds":["7790502e9ddbded84570","3fc44a99fd5775ba24c0","6aca3a6f6c011c88b9fa","a47cac436f94fd013649","2d192019dc2392c377a9"]}]}]}
