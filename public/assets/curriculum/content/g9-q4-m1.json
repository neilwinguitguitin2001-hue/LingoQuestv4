{"fileId":"1o60IXjYfDk03sBQQqiq1UbUEKU18GqgT","sourceSha256":"f65181f424a510d50ee3f815a78b78c790536cd4fbbe209c4e59cd0c8bbb8834","blocks":{"08e237adad1ffdbd0c8b":{"type":"heading","page":9,"text":"Language Highlights","bbox":[94.58399963378906,171.5403289794922,220.04359436035156,184.40191650390625]},"f6f7e20cbffd7199f554":{"type":"paragraph","page":9,"text":"Modal verbs include can, must, may, might, will, would, should. They are used with other verbs to express ability, obligation, possibility, and so on. Below is a list showing the most useful modals and their most common meanings:","bbox":[94.58399963378906,201.1803436279297,526.5179443359375,243.82395935058594]},"f97ef4e1bb2ee9113409":{"type":"heading","page":9,"text":"Modal","bbox":[97.58399963378906,260.5802917480469,135.65359497070312,273.44189453125]},"4c5df73a88dadaa78c96":{"type":"heading","page":9,"text":"Meaning","bbox":[202.49000549316406,260.5802917480469,254.60360717773438,273.44189453125]},"80eff01c1b289c4853b7":{"type":"heading","page":9,"text":"Example","bbox":[386.8299865722656,260.5802917480469,439.693603515625,273.44189453125]},"f8050648fbfc22bc3308":{"type":"paragraph","page":9,"text":"can","bbox":[97.58399963378906,290.3702697753906,120.43280029296875,303.25396728515625]},"98d645fbc8e28894f32e":{"type":"paragraph","page":9,"text":"to express ability","bbox":[180.1699981689453,290.3702697753906,273.4820251464844,303.3091735839844]},"a5531b18faa42858b6a8":{"type":"paragraph","page":9,"text":"I can speak a little Russian.","bbox":[351.19000244140625,290.2502746582031,504.1528015136719,303.1891784667969]},"40b5c414706f9ef04cf2":{"type":"paragraph","page":9,"text":"can","bbox":[97.58399963378906,320.0102844238281,120.43280029296875,332.89398193359375]},"6e76f58877494eacc494":{"type":"paragraph","page":9,"text":"to request permission","bbox":[180.1699981689453,320.0102844238281,296.1820068359375,332.9491882324219]},"5429d0d1bb0bf781f28e":{"type":"paragraph","page":9,"text":"Can I open the window?","bbox":[351.19000244140625,320.0102844238281,483.872802734375,332.9491882324219]},"d119e8ed0166dc925cdf":{"type":"paragraph","page":9,"text":"may","bbox":[97.58399963378906,349.7702941894531,123.79280090332031,362.65399169921875]},"2cd1c61406717ad16138":{"type":"paragraph","page":9,"text":"to express possibility","bbox":[180.1699981689453,349.7702941894531,294.1419982910156,362.7091979980469]},"dd6ac90238a23255bab9":{"type":"paragraph","page":9,"text":"I may be home late.","bbox":[351.19000244140625,349.6502990722656,460.8327941894531,362.5892028808594]},"c206d5a06e5c1ff088ce":{"type":"paragraph","page":9,"text":"may","bbox":[97.58399963378906,379.4103088378906,123.79280090332031,392.29400634765625]},"9e86ffbddbaf8b146b07":{"type":"paragraph","page":9,"text":"to request permission","bbox":[180.1699981689453,379.4103088378906,296.4028015136719,392.3492126464844]},"cfb0b6eeeb3e0a9b1f18":{"type":"paragraph","page":9,"text":"May I sit down, please?","bbox":[351.19000244140625,379.4103088378906,480.6328125,392.3492126464844]},"0b3a36b94b355642f602":{"type":"paragraph","page":9,"text":"must","bbox":[97.58399963378906,409.1702880859375,128.8328094482422,422.0539855957031]},"01610f0426b1c8957a04":{"type":"paragraph","page":9,"text":"to express obligation","bbox":[180.1699981689453,409.1702880859375,291.7220153808594,422.10919189453125]},"1b95689738811012cb8a":{"type":"paragraph","page":9,"text":"I must go now.","bbox":[351.19000244140625,409.05029296875,432.6520080566406,421.98919677734375]},"8229297225964f83213f":{"type":"paragraph","page":9,"text":"must","bbox":[97.58399963378906,438.810302734375,128.8328094482422,451.6940002441406]},"f367b59ad01fd5a2c726":{"type":"paragraph","page":9,"text":"to express strong belief","bbox":[180.1699981689453,438.810302734375,305.1820068359375,451.74920654296875]},"ac6a19164fba0394ca7f":{"type":"paragraph","page":9,"text":"She must be over 90 years old.","bbox":[351.19000244140625,438.810302734375,519.2727661132812,451.74920654296875]},"811424ac431468ea88ae":{"type":"paragraph","page":9,"text":"should","bbox":[97.58399963378906,468.5903015136719,137.8328094482422,481.4739990234375]},"9aeb72f8b666fe0a5672":{"type":"paragraph","page":9,"text":"to give advice","bbox":[180.1699981689453,468.5903015136719,255.0019989013672,481.5292053222656]},"bc2cc871ef3292d5252c":{"type":"paragraph","page":9,"text":"You should stop smoking.","bbox":[351.19000244140625,468.4703063964844,493.5928039550781,481.4092102050781]},"dbd913f39cbf45cf3058":{"type":"paragraph","page":9,"text":"would","bbox":[97.58399963378906,498.23028564453125,133.51280212402344,511.1139831542969]},"7940051e5bb2fce29c2e":{"type":"paragraph","page":9,"text":"to request or offer","bbox":[180.1699981689453,498.23028564453125,276.12200927734375,511.169189453125]},"c32e7a06a1eb3c3a8c15":{"type":"paragraph","page":9,"text":"Would you like a cup of tea?","bbox":[351.19000244140625,498.23028564453125,506.31280517578125,511.169189453125]},"cce8e15d28183429f8c5":{"type":"paragraph","page":9,"text":"would","bbox":[97.58399963378906,527.9903564453125,133.51280212402344,540.8740234375]},"d5b20fccd98066d15518":{"type":"paragraph","page":9,"text":"in if-sentences","bbox":[180.1699981689453,527.9903564453125,259.322021484375,540.92919921875]},"ea2790e0b73b78af62ce":{"type":"paragraph","page":9,"text":"If I were you, I would say sorry.","bbox":[351.19000244140625,527.870361328125,523.4920043945312,540.8092041015625]},"377e7c52c726d8a74ed9":{"type":"paragraph","page":9,"text":"can't","bbox":[97.58399963378906,557.63037109375,127.03279876708984,570.5140380859375]},"4fcbe037535b85fcfdde":{"type":"paragraph","page":9,"text":"to express prohibition","bbox":[180.1699981689453,557.63037109375,296.5420227050781,570.5692138671875]},"c1c1f04a1c203a578ae3":{"type":"paragraph","page":9,"text":"You can’t drive that car. You mustn't use your phone in","bbox":[351.19000244140625,557.63037109375,541.111083984375,585.3939819335938]},"bd5dffe8cf3ba1bebfa0":{"type":"paragraph","page":9,"text":"mustn't","bbox":[97.58399963378906,587.3903198242188,142.7528076171875,600.2739868164062]},"5dcfee17b25cebd7a19e":{"type":"paragraph","page":9,"text":"class.","bbox":[350.8299865722656,587.3903198242188,384.7228088378906,600.2739868164062]},"5e742109f779f0a8cf1b":{"type":"heading","page":9,"text":"Points to Remember on Prohibition:","bbox":[94.58399963378906,617.0303344726562,305.50360107421875,629.8919067382812]},"a615eea653adb87bcdbd":{"type":"paragraph","page":9,"text":"Can't usually give the idea of something that is against the rules while. Mustn't usually means that it is the speaker who is setting the rule. Example:","bbox":[94.58399963378906,631.9103393554688,526.7939453125,674.4639892578125]},"65f78e4588c32e44dd38":{"type":"paragraph","page":9,"text":"We can’t go inside the malls without face mask. We must wear face mask properly","bbox":[180.0500030517578,661.580322265625,439.7127990722656,689.343994140625]},"5d4bff7b536c2abd46be":{"type":"paragraph","page":9,"text":"So, now that you understand the expressions using modal verbs. You are","bbox":[108.0199966430664,691.34033203125,506.1336975097656,704.2239990234375]},"e625d1545f36e5c2a5da":{"type":"paragraph","page":9,"text":"now ready to answer all the activities provided for you. So, enjoy the learning tasks in this module.","bbox":[72.02400207519531,705.2603149414062,521.8735961914062,731.9439697265625]},"efc1399bf34e1db24cee":{"type":"paragraph","page":16,"text":"Descriptive words are also called word modifiers. They give a more specific","bbox":[108.0199966430664,460.6702880859375,526.1934204101562,473.5539855957031]},"da1bc9e44c8e38a6277f":{"type":"paragraph","page":16,"text":"meaning to the word they modify. In English, there are two kinds of descriptive words: an adjective and an adverb. If a noun or a pronoun is described in a sentence, your modifier is an adjective. The modifier is an adverb if it describes an adjective, a verb, or another adverb.","bbox":[72.02400207519531,475.4302978515625,526.5925903320312,532.9539794921875]},"52ce3200063b88280f72":{"type":"paragraph","page":16,"text":"To help you identify which is an adjective or adverb, always remember what","bbox":[108.0199966430664,553.55029296875,526.1712036132812,566.4339599609375]},"1914c463efd8254dc769":{"type":"paragraph","page":16,"text":"question it answers. Adjective answers the questions what kind, how many, or which one while an adverb answers the questions how, when, where, why, or to what extent.","bbox":[72.02400207519531,568.4302978515625,526.5927734375,596.1939697265625]},"4cd31ef471466e490bfc":{"type":"paragraph","page":16,"text":"In addition, descriptive words are very important in making an evaluation or","bbox":[108.0199966430664,618.1103515625,526.1712646484375,630.9940185546875]},"14c42e734b767baf4c7c":{"type":"paragraph","page":16,"text":"judgment to a certain act, be it in a role play, individual or group performance in the classroom, or talent show in school. These words make an evaluation more interesting and full of details. It further gives clarity and understanding of the act or presentation.","bbox":[72.02400207519531,632.9903564453125,526.51171875,690.4240112304688]},"255d985e3019b97f96fd":{"type":"paragraph","page":17,"text":"Compare the evaluation below.","bbox":[72.02400207519531,68.92032623291016,241.66281127929688,81.80400848388672]},"e5f944abdc9c904e1245":{"type":"table","rows":[["Without Descriptive Words","With Descriptive Words"],["Our group performs a dance act on stage.","Our group performs the most synchronous dance act on stage."],["My friend is a song writer and a singer at the same time.","My friend is a well-known song writer and an amazing singer as well."]],"bbox":[79.76400089263916,90.06001790364583,506.9200019836426,197.0199991861979],"text":"Without Descriptive Words With Descriptive Words Our group performs a dance act on stage. Our group performs the most synchronous dance act on stage. My friend is a song writer and a singer at the same time. My friend is a well-known song writer and an amazing singer as well.","page":17},"8c4ca42eaedcb7d5aefd":{"type":"paragraph","page":17,"text":"The highlighted words, most synchronous, well-known and amazing under with Descriptive Words add vivid details to the words they modify. Thus, they make the thought of the sentences clearer and more interesting.","bbox":[72.02400207519531,217.98033142089844,526.552001953125,260.6240234375]}},"excerptBlocks":{"concepts:0":["08e237adad1ffdbd0c8b","f6f7e20cbffd7199f554","f97ef4e1bb2ee9113409","4c5df73a88dadaa78c96","80eff01c1b289c4853b7","f8050648fbfc22bc3308","98d645fbc8e28894f32e","a5531b18faa42858b6a8","40b5c414706f9ef04cf2","6e76f58877494eacc494","5429d0d1bb0bf781f28e","d119e8ed0166dc925cdf","2cd1c61406717ad16138","dd6ac90238a23255bab9","c206d5a06e5c1ff088ce","9e86ffbddbaf8b146b07","cfb0b6eeeb3e0a9b1f18","0b3a36b94b355642f602","01610f0426b1c8957a04","1b95689738811012cb8a","8229297225964f83213f","f367b59ad01fd5a2c726","ac6a19164fba0394ca7f","811424ac431468ea88ae","9aeb72f8b666fe0a5672","bc2cc871ef3292d5252c","dbd913f39cbf45cf3058","7940051e5bb2fce29c2e","c32e7a06a1eb3c3a8c15","cce8e15d28183429f8c5","d5b20fccd98066d15518","ea2790e0b73b78af62ce","377e7c52c726d8a74ed9","4fcbe037535b85fcfdde","c1c1f04a1c203a578ae3","bd5dffe8cf3ba1bebfa0","5dcfee17b25cebd7a19e","5e742109f779f0a8cf1b","a615eea653adb87bcdbd","65f78e4588c32e44dd38","5d4bff7b536c2abd46be","e625d1545f36e5c2a5da"],"concepts:1":["efc1399bf34e1db24cee","da1bc9e44c8e38a6277f","52ce3200063b88280f72","1914c463efd8254dc769","4cd31ef471466e490bfc","14c42e734b767baf4c7c"],"concepts:2":["255d985e3019b97f96fd","e5f944abdc9c904e1245","8c4ca42eaedcb7d5aefd"]},"games":[{"difficulty":"easy","answer":"Descriptive words","explanation":"Descriptive words are also called word modifiers.","timeLimitSeconds":45,"source":{"fileId":"1o60IXjYfDk03sBQQqiq1UbUEKU18GqgT","page":16,"quote":"Descriptive words are also called word modifiers.","answerQuote":"Descriptive words","sourceId":"04d