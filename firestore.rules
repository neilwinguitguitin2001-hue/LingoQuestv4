rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Legacy identifiable leaderboards are retained but never readable or writable by clients.
  match /leaderboard/{id} { allow read,write: if false; }
  // The active privacy implementation uses Supabase. Legacy performance writes are retired.
  // Do not apply without reviewing the Firebase deployment, if it is still in use.
  match /users/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list,write: if false; }
  match /progress/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list,write: if false; }
  match /quizResults/{id} { allow get: if request.auth != null && resource.data.userId == request.auth.uid; allow list,write: if false; }
  match /{document=**} { allow read,write: if false; }
 }
}
